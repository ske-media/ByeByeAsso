{
  "name": "@kroov/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL access layer: Drizzle schema, migrations, connection pool, transaction helpers.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "check": "drizzle-kit check",
    "reset": "tsx src/cli/reset.ts",
    "test": "vitest run --root . --passWithNoTests"
  },
  "dependencies": {
    "@kroov/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
