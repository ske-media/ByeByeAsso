{
  "name": "@kroov/payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Payment provider adapters implementing the domain port: stripe (Connect) and fake (local simulated provider for development and tests).",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake.ts",
    "./stripe": "./src/stripe.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root . --passWithNoTests"
  },
  "dependencies": {
    "@kroov/domain": "workspace:*",
    "stripe": "23.0.1"
  },
  "devDependencies": {
    "@kroov/config": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
