# ---------------------------------------------------------------------------
# Kroov — environment template. Copy to .env and fill in. Never commit .env.
# Every variable is validated at boot by packages/config/src/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Politique (console e-mail, cookies sécurisés, rate limiting) : development | test | staging | production.
# Non défini + NODE_ENV=production ⇒ production (choix sûr par défaut).
APP_ENV=development
APP_NAME=Kroov
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kroov
LOG_LEVEL=info

# PostgreSQL (docker compose: infra/docker-compose.yml)
# Supabase : utiliser la chaîne « Transaction pooler » (port 6543) du projet, ex.
# DATABASE_URL=postgresql://postgres.REF:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# (le mot de passe n'est jamais commité : variable d'environnement de l'hébergeur).
# Les clés NEXT_PUBLIC_SUPABASE_* ne sont pas utilisées par Kroov (accès serveur uniquement, via Drizzle).
DATABASE_URL=postgres://kroov:kroov@localhost:5432/kroov
DATABASE_URL_TEST=postgres://kroov:kroov@localhost:5432/kroov_test
DATABASE_POOL_MAX=10

# Authentication (Phase 1). Generate: openssl rand -base64 48
AUTH_SECRET=

# Stripe Connect (Phase 3). Use TEST keys locally; never paste live keys here.
# Paiements : `fake` (simulateur local, développement/test uniquement) ou `stripe`.
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=fake-webhook-secret-for-local-use-only
# Frais acheteur par billet payant (commission plateforme) : points de base + fixe en unités mineures.
PLATFORM_FEE_BPS=400
PLATFORM_FEE_FIXED_MINOR=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# E-mail. console = log only; file = JSON lines (tests E2E, EMAIL_FILE_PATH); smtp = Mailpit at http://localhost:8025; resend = production provider.
EMAIL_PROVIDER=console
# Phase 8 — rappels fournisseur (fake en test ; secret de signature svix pour Resend) et taille des lots de campagne
EMAIL_WEBHOOK_SECRET=fake-email-webhook-secret-local-only
CAMPAIGN_BATCH_SIZE=50
EMAIL_FROM=no-reply@kroov.local
EMAIL_FILE_PATH=.tmp/outbox.jsonl
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# S3-compatible object storage (MinIO locally: console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=kroov-dev
S3_ACCESS_KEY_ID=kroov
S3_SECRET_ACCESS_KEY=kroov-dev-secret
S3_FORCE_PATH_STYLE=true

# Worker
WORKER_CONCURRENCY=4
