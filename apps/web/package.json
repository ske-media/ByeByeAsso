    "@kroov/domain": "workspace:*",
    "@kroov/notifications": "workspace:*",
    "@kroov/ui": "workspace:*",
    "@kroov/validation": "workspace:*",
    "better-auth": "1.7.14",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
