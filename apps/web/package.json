{
  "name": "@kroov/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kroov web application (Next.js App Router): organizer workspace, public pages, personal space, scanner, /api/v1.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
